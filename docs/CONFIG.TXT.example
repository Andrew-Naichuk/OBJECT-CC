# OBJECT CONFIG.TXT — change these from Settings in the OBJECT hub,
# or edit on any computer and reinsert the card. Saving from the hub
# rewrites this file. Missing file is created with defaults on first boot.
#
# wheel_circ_mm: measured rollout in millimetres (700x32C ~2155)
wheel_circ_mm=2155
#
# timezone_offset_min: minutes from UTC for archive filenames only
# (GPX timestamps stay UTC). Example: 120 = UTC+2, -300 = UTC-5
timezone_offset_min=0
#
# backlight at boot: bright | dim | off
backlight=bright
#
# BLE advertise name (1-20 chars, no spaces)
ble_name=OBJECT-001
#
# units: metric | imperial  (display only; storage stays metric)
units=metric
#
# dim PWM duty 1-254 (bright is always 255)
backlight_dim=40
#
# max_speed_kmh: treat faster reed intervals as noise
max_speed_kmh=100
#
# stopped_ms: no pulse for this long => bike stopped (moving time)
stopped_ms=3000
#
# animations: on | off  (face when stopped, celebrations, transitions)
animations=on
